{
  // Type-checks the tests (npm run test:typecheck). Vitest itself runs them
  // without type-checking, the same way Vite serves the app.
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": [".", "../src"]
}

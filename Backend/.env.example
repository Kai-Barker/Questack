# Copy to .env and fill in. Never commit the real .env.

# Aiven MySQL: Service URI from the Aiven console (Overview -> Connection information)
DATABASE_URL=
# Optional: the Aiven CA certificate as a string (otherwise certs/ca.pem is used)
DB_CA_CERT=

# Server
PORT=3000
CLIENT_URL=http://localhost:5173
# "production" makes the session cookie HTTPS-only
NODE_ENV=
# Number of proxy hops in front of the API in production (e.g. 1 behind the Vercel rewrite); leave empty locally
TRUST_PROXY=
# Dev only: "true" unlocks every frame and visor for every pilot, for testing.
# Ignored when NODE_ENV=production. Never set it on the deployed backend.
DEV_UNLOCK_ALL_GEAR=

# Auth: at least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a normal session lasts, e.g. 12h or 7d ("keep me signed in" is always 30 days)
JWT_EXPIRES_IN=7d

# Gemini (get a key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
